# ── Required ──────────────────────────────────────────────────────
# URL of the deployed backend (Render / Railway / etc.)
VITE_BACKEND_URL=https://veribounty-backend.onrender.com

# ── Optional (defaults are fine for Devnet) ───────────────────────
# Solana program ID (defaults to the value in the IDL JSON)
VITE_PROGRAM_ID=36aWnuK3fcbHBXhuSDZcEwgnZhgcQKdB9Drgkj8twUMW

# Custom RPC endpoint (optional — avoids devnet public rate limits)
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public key of the trusted resolver wallet (must match TRUSTED_RESOLVER in lib.rs).
# The resolver connects with this wallet to see the Accept / Reject / Refund panel.
VITE_RESOLVER_PUBKEY=GFEJ3s8AmahS1SPCsrSAetSc2e8VYAGXfVTJcxF45nKE
